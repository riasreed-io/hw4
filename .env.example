# Copy this file to .env in this folder (hw4/.env) and fill in your own key.
# The real .env is gitignored and must never be committed.

# The agent's model provider. Use whichever one you have.
# Portkey (class gateway) -> defaults to gpt-5.6-luna
PORTKEY_API_KEY=pk-your-portkey-key-here

# Optional: a Portkey virtual key, if your gateway setup uses one.
PORTKEY_VIRTUAL_KEY=

# OpenAI direct -> defaults to gpt-4o. Only needed if you are not using Portkey.
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=

# Optional: override the model name for either provider.
# OPENAI_MODEL=gpt-5.6-luna
